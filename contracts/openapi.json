  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/configuracoes": {
      "get": {
        "description": "Prazos, pesos e limites em vigor para o perfil de execução atual.",
        "operationId": "admin_consultar_configuracoes",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfiguracoesEfetivas"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Consultar Configuracoes",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/prazos/varrer": {
      "post": {
        "description": "Força a verificação imediata de tudo que depende de prazo (expirações e liberações).",
        "operationId": "admin_varrer_prazos",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultadoVarredura"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Varrer Prazos",
        "tags": [
          "admin"
        ]
