      "get": {
        "description": "Pontos para o mapa, de vagas ou de profissionais (resposta de exemplo).",
        "operationId": "mapa_listar_pontos_do_mapa",
        "parameters": [
          {
            "in": "query",
            "name": "tipo",
            "required": false,
            "schema": {
              "default": "vaga",
              "enum": [
                "vaga",
                "profissional"
              ],
              "title": "Tipo",
              "type": "string"
            }
          },
          {
            "description": "Latitude do centro da busca.",
            "in": "query",
            "name": "latitude",
            "required": false,
            "schema": {
              "default": -8.0476,
              "description": "Latitude do centro da busca.",
              "title": "Latitude",
              "type": "number"
            }
          },
          {
            "description": "Longitude do centro da busca.",
            "in": "query",
            "name": "longitude",
            "required": false,
            "schema": {
              "default": -34.877,
              "description": "Longitude do centro da busca.",
              "title": "Longitude",
              "type": "number"
            }
          },
          {
            "description": "Raio da busca, de 1 a 15 km.",
            "in": "query",
            "name": "raio_km",
            "required": false,
            "schema": {
              "default": 5,
              "description": "Raio da busca, de 1 a 15 km.",
              "maximum": 15,
              "minimum": 1,
              "title": "Raio Km",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PontoMapa"
                  },
                  "title": "Response Mapa Listar Pontos Do Mapa",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Listar Pontos Do Mapa",
        "tags": [
          "mapa"
        ]
      }
    },
