# Perfil de execução: producao ou demo (prazos curtos para apresentações)
PERFIL=producao

# PostgreSQL local subido por docker-compose.yml.
# Para rodar sem Docker, use SQLite: sqlite:///./freelai.db
DATABASE_URL=postgresql+psycopg://freelai:freelai@localhost:5432/freelai

SECRET_KEY=replace-this-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:3000"]
