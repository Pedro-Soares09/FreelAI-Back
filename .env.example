# Ambiente: desenvolvimento ou producao. Em producao a aplicação não inicia com SECRET_KEY
# padrão ou com menos de 32 caracteres.
AMBIENTE=desenvolvimento

# Perfil de execução: producao ou demo (prazos curtos para apresentações)
PERFIL=producao

# PostgreSQL local subido por docker-compose.yml (docker compose up -d db).
# Para rodar sem Docker, use SQLite: sqlite:///./freelai.db
DATABASE_URL=postgresql+psycopg://freelai:freelai@localhost:5432/freelai

# Gere um valor aleatório, por exemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-this-with-a-long-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Geocodificação de bairros fora da tabela embutida pelo OpenStreetMap (Nominatim)
GEOCODIFICACAO_OSM=false
CORS_ORIGINS=["http://localhost:3000"]
